<?xml version="1.0" encoding="utf-8"?>
<!-- The only persisted secret is the SmartLink refresh token, which is bound to
     the device keystore. Excluding it from backup and transfer keeps it from
     leaving the device it was minted on. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
